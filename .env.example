# Database (Docker Compose default)
DATABASE_URL=postgresql://rescue:rescue@127.0.0.1:5433/rescue_router

# Auth — use a long random string in production
AUTH_SECRET=replace-with-at-least-32-chars-in-prod

# Public URL the browser uses (Vite dev server + proxy to API)
AUTH_BASE_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
# Google Maps JS API key (browser key; restrict to your local/prod origins)
VITE_GOOGLE_MAPS_API_KEY=

# SMTP (Mailpit defaults for local dev)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Rescue Router <noreply@localhost>

# API server
PORT=4000

# --- Demo data & “Try demo” in the app ---
# Allows `yarn demo:seed` to insert demo users, dogs, and a sample transport (trusted envs only).
ALLOW_DEMO_SEED=true
# Optional alias checked by the seed script:
# DEMO_MODE=true
#
# Shared demo account mutations: blocked in production by default. Set DEMO_READ_ONLY=false
# for a writable public demo (use with care). In development, demo users can mutate by default.
# DEMO_READ_ONLY=true
# DEMO_READ_ONLY=false
#
# “Try demo” menu → POST /api/demo/enter (shared coordinator account). Allowed locally when
# NODE_ENV is not production; in production set DEMO_ENTER_ENABLED=true to opt in.
# DEMO_ENTER_ENABLED=true
# DEMO_ENTER_ENABLED=false
# DEMO_GUEST_PASSWORD=  # required in prod; dev defaults to seed password — must match demo *coordinator*
# Optional — only if the seeded driver email was changed from the default:
# DEMO_GUEST_EMAIL=
