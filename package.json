{
  "name": "rescue-router",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "run-p dev:api dev:web",
    "dev:api": "yarn workspace @rescue-router/api dev",
    "dev:web": "yarn workspace @rescue-router/web dev",
    "build:api": "yarn workspace @rescue-router/api run build",
    "build:web": "yarn workspace @rescue-router/web run build",
    "build": "run-p build:api build:web",
    "db:generate": "yarn workspace @rescue-router/db generate",
    "db:migrate": "yarn workspace @rescue-router/db migrate",
    "db:studio": "yarn workspace @rescue-router/db studio",
    "demo:seed": "yarn workspace @rescue-router/api demo:seed",
    "lint": "yarn workspaces run lint",
    "test": "vitest run"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "3.2.4"
  },
  "packageManager": "yarn@1.22.22"
}
